# ==============================================================================
# MAZAL POS & ERP - GIT IGNORE CONFIGURATION
# Seguridad y exclusión de datos sensibles para repositorio público
# ==============================================================================

# Node & Package Manager Dependencies
node_modules/
mazal/node_modules/
.pnp
.pnp.js
.yarn/
package-lock.json.bak

# Testing, Coverage & Cache
coverage/
.nyc_output/
.cache/
.parcel-cache/
.turbo/

# Production Build Outputs
dist/
mazal/dist/
build/
out/

# Environment Files & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
!.env.example
mazal/.env
mazal/.env.*
!mazal/.env.example
*.pem
*.key
*.crt
*.pfx
*.keystore

# Databases, SQL Dumps & Local Backups
backups/
*.sql
!scripts/sql/mazal_mysql_schema.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.rdb

# User Uploads & Media Assets
uploads/
temp_media/
user_uploads/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Temporary Files & AI IDE Artifacts
tmp/
temp/
.gemini/
