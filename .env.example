# ==============================================================================
# MAZAL POS & ERP - ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# --- CREDENCIALES DE ACCESO MAESTRO ---
VITE_USER_ADMIN_NAME="Administrador General"
VITE_USER_ADMIN_USER="admin"
VITE_USER_ADMIN_PASSWORD="admin"
VITE_USER_ADMIN_ROLE="Administrador"

# --- CONTRASEÑAS DE ACCESO POR SUCURSAL ---
VITE_BRANCH_PASSWORD_NORTE="admin"
VITE_BRANCH_PASSWORD_SUR="admin"
VITE_BRANCH_PASSWORD_CENTRO="admin"
VITE_BRANCH_PASSWORD_BODEGA="admin"

# --- CONEXIÓN A BASE DE DATOS SUPABASE CLOUD (POSTGRESQL EN LÍNEA) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# --- PUERTO DEL SERVIDOR WEB (RAILWAY ASIGNA AUTOMÁTICAMENTE) ---
PORT=3000
