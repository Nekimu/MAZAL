# ==============================================================================
# MAZAL POS & ERP - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copia este archivo como .env y coloca tus credenciales reales de producción.
# NUNCA subas tu archivo .env real al repositorio de Git ni reveles tus claves.
# ==============================================================================

# --- CONEXIÓN A BASE DE DATOS SUPABASE CLOUD (POSTGRESQL EN LÍNEA) ---
# Obtén estos valores en tu panel de Supabase: Project Settings -> API / Database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# --- AUTENTICACIÓN SERVER-SIDE & JWT (RAILWAY / BACKEND) ---
# Clave secreta para firmar tokens JWT (Genera una clave aleatoria segura de 64 caracteres)
# En terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-secure-random-secret-in-production"

# Contraseña inicial de administrador general maestro (o usa: npm run seed:admin)
VITE_USER_ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- CONEXIÓN DIRECTA / TRANSACTION POOLER (MIGRACIONES O BACKEND SERVER) ---
SUPABASE_HOST="aws-0-your-region.pooler.supabase.com"
SUPABASE_PORT="5432"
SUPABASE_DB="postgres"
SUPABASE_USER="postgres.your-project-ref"
SUPABASE_DB_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# --- PUERTO DEL SERVIDOR WEB (RAILWAY / DOCKER ASIGNA AUTOMÁTICAMENTE) ---
PORT=3000
