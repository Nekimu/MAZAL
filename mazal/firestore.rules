rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Helper Functions de Autenticación y Validación de Tokens
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && (getRole() == 'admin' || getRole() == 'Administrador');
    }

    function isManager() {
      return isAdmin() || (isSignedIn() && (getRole() == 'manager' || getRole() == 'Gerente'));
    }

    function isCashier() {
      return isManager() || (isSignedIn() && (getRole() == 'cashier' || getRole() == 'Cajero'));
    }

    function isWarehouse() {
      return isManager() || (isSignedIn() && (getRole() == 'warehouse' || getRole() == 'Almacenista'));
    }

    function isPurchasing() {
      return isManager() || (isSignedIn() && (getRole() == 'purchasing' || getRole() == 'Compras'));
    }

    function isAccountant() {
      return isManager() || (isSignedIn() && (getRole() == 'accountant' || getRole() == 'Contabilidad'));
    }

    // 2. Usuarios del Sistema
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Catálogo de Productos y Existencias Multi-Sucursal
    match /products/{productId} {
      allow read: if true; // Catálogo público para POS y portal de consulta
      allow create, update: if isWarehouse() || isManager();
      allow delete: if isAdmin();
    }

    match /products_norte/{productId} {
      allow read: if true;
      allow create, update: if isWarehouse() || isManager();
      allow delete: if isAdmin();
    }

    match /products_sur/{productId} {
      allow read: if true;
      allow create, update: if isWarehouse() || isManager();
      allow delete: if isAdmin();
    }

    match /branch_inventory/{invId} {
      allow read: if isSignedIn();
      allow write: if isWarehouse() || isManager();
    }

    // 4. Ventas y Transacciones
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isCashier() 
        && request.resource.data.total >= 0;
      allow update, delete: if isManager();
    }

    // 5. Movimientos de Inventario (Kárdex)
    match /stock_movements/{movId} {
      allow read: if isSignedIn();
      allow create: if isWarehouse() 
        && request.resource.data.quantity != 0;
      allow update, delete: if isAdmin();
    }

    // 6. Cortes y Sesiones de Caja
    match /cash_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isCashier();
      allow delete: if isAdmin();
    }

    match /cash_expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isCashier() 
        && request.resource.data.amount > 0;
      allow update, delete: if isManager();
    }

    // 7. Clientes y Proveedores
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isCashier();
      allow delete: if isManager();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if isPurchasing();
      allow delete: if isAdmin();
    }

    match /purchase_orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isPurchasing();
      allow delete: if isAdmin();
    }

    // 8. Finanzas Empresariales
    match /bank_accounts/{accountId} {
      allow read, write: if isAccountant();
    }

    match /bank_movements/{movId} {
      allow read, write: if isAccountant();
    }

    match /budgets/{budgetId} {
      allow read, write: if isAccountant();
    }

    match /cost_centers/{centerId} {
      allow read, write: if isAccountant();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // 9. Bitácora de Auditoría (Append-Only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Inmutable para auditoría legal
    }

    // 10. Configuración del Sistema y Estado Global
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /roles_permisos/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_state/{stateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bloqueo por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
