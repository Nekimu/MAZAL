{
  "name": "mazal-pos-erp",
  "version": "2.5.0",
  "description": "Sistema MAZAL POS & ERP con Base de Datos en Supabase Cloud y Despliegue en Railway",
  "main": "server.js",
  "scripts": {
    "postinstall": "node -e \"if (require('fs').existsSync('./mazal/package.json')) { require('child_process').execSync('npm --prefix mazal install', { stdio: 'inherit' }); }\"",
    "build": "npm --prefix mazal run build",
    "start": "node server.js",
    "dev": "npm --prefix mazal run dev",
    "seed:supabase": "node scripts/seed_supabase.mjs"
  },
  "keywords": [
    "pos",
    "erp",
    "supabase",
    "react",
    "vite",
    "railway",
    "retail",
    "abarrotes"
  ],
  "author": "Mazal ERP Team",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
