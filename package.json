{
  "name": "mazal-pos-erp",
  "version": "2.5.0",
  "description": "Sistema MAZAL POS & ERP con Base de Datos en Supabase Cloud y Despliegue en Railway",
  "main": "server.js",
  "scripts": {
    "postinstall": "node -e \"if (require('fs').existsSync('./mazal/package.json')) { require('child_process').execSync('npm --prefix mazal install', { stdio: 'inherit' }); }\"",
    "build": "npm --prefix mazal run build && node -e \"if (require('fs').existsSync('./mazal/dist')) require('fs').cpSync('./mazal/dist', './dist', {recursive: true, force: true})\"",
    "start": "node server.js",
    "dev": "npm --prefix mazal run dev",
    "seed:supabase": "node scripts/seed_supabase.mjs",
    "migrate:supabase": "node scripts/migrate_mysql_to_supabase.mjs",
    "purge:supabase": "node scripts/purge_and_verify_supabase.mjs",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "keywords": [
    "pos",
    "erp",
    "supabase",
    "react",
    "vite",
    "railway",
    "retail",
    "abarrotes"
  ],
  "author": "Mazal ERP Team",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
